&CONTROL
   calculation  = 'scf'
   restart_mode = 'from_scratch',
   tprnfor      = .true.
   tstress      = .false.
   !nstep        = 4
   pseudo_dir   = '/home/buxuande/pseudo/nc-sr-05_pbe_standard_upf'
   prefix       = 'kagome_221'
   wf_collect   = .true.
   outdir       = './tmp'
   verbosity    = 'medium'
   !td_is_on     = .true.
   td_mstep     = 200
   !dt           = 0.5
   td_edt       = 0.5
   td_lstep = 20
   td_frozen_ion_step = 300
   !td_nwevc     = 1
   !td_nwcoeff   = 100
   td_nwcur     = 1
   td_int_method= 0
   td_h_interp  = 0
   !td_wfctype = 1
   !td_nwevc = 1
   !td_nwcoeff = 1
   !td_coe = .true.
   td_cal_current = .True. !, .false. , .false. , .true.
   !td_debug = .false.,.true.,.true.,.true.
   !               Ax(V/A)   Ay   Az  omega(eV)  t0(fs) sigma(fs)  phi_x(pi)  phi_y  phi_z
   td_laser_para =  0.0    0.0  0.0      1.0     3     0.8          0         -0.5       0
 /

&SYSTEM
  ibrav= 0, nat= 36, ntyp= 3,
  occupations = 'smearing', smearing = 'f-d', degauss = 2.0d-4,
  ecutwfc = 100, !ecutrho = 500,
  noinv = .true.
  nosym = .true. 
  !lspinorb=.true.
  !noncolin=.true.
/
&ELECTRONS
  conv_thr = 1.0d-9
  mixing_beta = 0.3d0
/
